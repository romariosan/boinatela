# =============================================================================================
# CompreGado — variáveis de produção.
# Copie para deploy/.env (cp .env.example .env), preencha e proteja: chmod 600 .env
# O .env está no .gitignore: NUNCA faça commit dele.
# =============================================================================================

# --- Stack -------------------------------------------------------------------------------------
# Prefixo do projeto, containers, rede e volumes. Em produção, deixe "compregado".
STACK_NOME=compregado

# --- PostgreSQL --------------------------------------------------------------------------------
POSTGRES_DB=compregado
POSTGRES_USER=compregado
# Gere com: openssl rand -hex 24
# Atenção: o Postgres só lê esta senha na criação do volume. Para trocar depois, use
# ALTER USER no banco (ver README) antes de mudar aqui.
POSTGRES_PASSWORD=
# Porta só no 127.0.0.1 da VPS (cliente SQL via túnel SSH). Não fica exposta na internet.
POSTGRES_PORT=5432

# --- Evolution API (WhatsApp do bot) -----------------------------------------------------------
# Chave global da Evolution (header "apikey"). Gere com: openssl rand -hex 24
EVOLUTION_API_KEY=
# Senha do usuário "evolution" no Postgres (pode ser trocada: é reaplicada a cada "up").
# Só letras e números (vai dentro de uma URL). Gere com: openssl rand -hex 24
EVOLUTION_DB_PASSWORD=
# Porta só no 127.0.0.1 da VPS: painel /manager via túnel SSH (ssh -L 8081:127.0.0.1:8081 ...).
EVOLUTION_PORT=8081
# URL pela qual você acessa o painel (pelo túnel). Usada como SERVER_URL da Evolution.
EVOLUTION_URL=http://localhost:8081
EVOLUTION_INSTANCIA=compregado
# Segredo que a Evolution enviava à API. O robô local usa o mesmo valor no radar (header X-Webhook-Token).
WHATSAPP_WEBHOOK_TOKEN=
# Segredo do robô local ao buscar a fila (header X-Robo-Token). Gere com: openssl rand -hex 24
ROBO_TOKEN=
# Número do chip de sistema, com DDI, só dígitos. O app não abre mais wa.me para o código.
WHATSAPP_BOT_NUMERO=5561994044146

# Três chips no mesmo aparelho de teste. Instâncias continuam separadas.
COMPREGADO_WHATSAPP_SYSTEM_NUMBER=5561994044146
COMPREGADO_WHATSAPP_SYSTEM_INSTANCE=compregado-system
COMPREGADO_WHATSAPP_SCRAPER_NUMBER=5561994044146
COMPREGADO_WHATSAPP_SCRAPER_INSTANCE=compregado-scraper
COMPREGADO_WHATSAPP_CONSULTANT_NUMBER=5561994044146
COMPREGADO_WHATSAPP_CONSULTANT_INSTANCE=compregado-consultant

# --- API Spring Boot ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Porta só no 127.0.0.1 da VPS. Tem que bater com o "upstream" do nginx-compregado.conf.
API_PORT=8080
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
# Origens que podem chamar a API, separadas por vírgula, sem barra no final.
# Site: https://appcompregado.com.br e www | Capacitor Android: https://localhost | iOS: capacitor://localhost
# Teste com o app rodando no PC: acrescente http://localhost:8100
CORS_ALLOWED_ORIGINS=https://appcompregado.com.br,https://www.appcompregado.com.br,https://localhost,capacitor://localhost

# --- Recursos ----------------------------------------------------------------------------------
API_MEM_LIMIT=1g
EVOLUTION_MEM_LIMIT=768m
