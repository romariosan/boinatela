# Copie para deploy/.env e preencha. Nunca faça commit do .env.

# Subdomínio apontado (registro A) para o IP da VPS. O Caddy emite o HTTPS sozinho.
API_DOMAIN=api.seudominio.com.br

POSTGRES_DB=boinatela
POSTGRES_USER=boinatela
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# Gere com: openssl rand -base64 48  (mínimo 32 caracteres)
JWT_SECRET=

# Origens que podem chamar a API, separadas por vírgula, sem barra no final.
# App web: https://seudominio.com.br | Capacitor Android: https://localhost | Capacitor iOS: capacitor://localhost
CORS_ALLOWED_ORIGINS=https://seudominio.com.br,https://localhost,capacitor://localhost

# Bot do WhatsApp. Sem eles, a verificação do número (exigida para publicar) e o "Esqueci minha senha" respondem 503.
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_BOT_URL=
WHATSAPP_BOT_TOKEN=

API_MEM_LIMIT=1g
